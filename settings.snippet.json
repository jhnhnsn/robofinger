{
  "hooks": {
    "SessionStart": [
      { "hooks": [{ "type": "command", "command": "robofinger start" }] }
    ],
    "SessionEnd": [
      { "hooks": [{ "type": "command", "command": "robofinger end" }] }
    ],
    "PreToolUse": [
      {
        "matcher": "*",
        "hooks": [{ "type": "command", "command": "robofinger check" }]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "*",
        "hooks": [{ "type": "command", "command": "robofinger activity idle" }]
      }
    ],
    "UserPromptSubmit": [
      { "hooks": [{ "type": "command", "command": "robofinger activity prompt" }] }
    ],
    "Notification": [
      { "hooks": [{ "type": "command", "command": "robofinger activity waiting" }] }
    ],
    "Stop": [
      { "hooks": [{ "type": "command", "command": "robofinger activity stop" }] }
    ],
    "SubagentStart": [
      { "hooks": [{ "type": "command", "command": "robofinger subagent-start" }] }
    ],
    "SubagentStop": [
      { "hooks": [{ "type": "command", "command": "robofinger subagent-stop" }] }
    ]
  }
}
