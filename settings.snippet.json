{
  "hooks": {
    "SessionStart": [
      { "hooks": [{ "type": "command", "command": "robofinger start" }] }
    ],
    "SessionEnd": [
      { "hooks": [{ "type": "command", "command": "robofinger end" }] }
    ],
    "PreToolUse": [
      {
        "matcher": "Edit|Write|NotebookEdit|Bash",
        "hooks": [{ "type": "command", "command": "robofinger check" }]
      }
    ],
    "SubagentStart": [
      { "hooks": [{ "type": "command", "command": "robofinger subagent-start" }] }
    ],
    "SubagentStop": [
      { "hooks": [{ "type": "command", "command": "robofinger subagent-stop" }] }
    ]
  }
}
